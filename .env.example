# Example environment — placeholders only, never real credentials.
TAXGUARD_ENVIRONMENT=development
TAXGUARD_APP_TITLE=TaxGuard
TAXGUARD_APP_VERSION=0.1.0
# Comma-separated https origins. Development defaults to localhost when unset;
# production defaults to no origins, so set the real frontend origin there.
TAXGUARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional Neon/PostgreSQL persistence (placeholders only, never real credentials).
# Unset (default) keeps the file-backed corpus. Database-backed mode (/ask with
# db=..., scripts/import_corpus.py --apply) requires TAXGUARD_DATABASE_URL.
# Use the pooled URL for app traffic; the unpooled URL for migrations.
# Neon hosts additionally require sslmode=require (or verify-ca / verify-full).
# TAXGUARD_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# TAXGUARD_DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# TAXGUARD_DB_POOL_MAX=5
# TAXGUARD_DB_CONNECT_TIMEOUT=10
# TAXGUARD_DB_STATEMENT_TIMEOUT_MS=30000
# TAXGUARD_DB_REQUIRE_SSL=true
